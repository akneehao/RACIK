# Copy to `.env` (gitignored) in this directory. Loaded automatically by
# racik/config.py on startup — no manual `export` needed. Without any of
# these, Agen Gizi/Agen Biaya and the /api/ask orchestrator all fall back to
# a deterministic, non-LLM path, so the app is fully demoable with nothing
# configured at all.
#
# Pick ONE provider block below and set RACIK_LLM_PROVIDER to match. The
# factory in racik/bedrock.py also auto-detects a provider from whichever
# model variable is set, so RACIK_LLM_PROVIDER is optional in most cases.

# ---------------------------------------------------------------- openai
# RACIK_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------- anthropic
# RACIK_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --------------------------------------------------------------- sealion
# Hosted api.sea-lion.ai. Simplest option, rate-limited, off your own infra.
# This is the default when nothing else is configured; without a key Racik
# answers with the rule-based fallback planner — same real tools and the
# same numbers, no model in the loop.
# RACIK_LLM_PROVIDER=sealion
SEALION_API_KEY=

# --------------------------------------------------------------- bedrock
# A stock Bedrock catalog model through the Converse API. This is the path
# the team uses on the hackathon's AWS Innovation Sandbox account.
#
# RACIK_LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary/STS/SSO credentials
#
# Two traps worth knowing before the demo:
#   * ISB credentials are temporary and expire ~8–12h after issue. When
#     calls start failing with ExpiredTokenException, re-export them from
#     the access portal — nothing in the code is wrong.
#   * Many Claude models on Bedrock are INFERENCE_PROFILE-only, so a bare
#     `anthropic.claude-...` id is rejected and you need the `us.` / `apac.`
#     prefixed profile id instead. `apac.*` and `global.*` in
#     ap-southeast-1 are additionally blocked by an org service control
#     policy on this account; `us-east-1` + a `us.*` profile works. Check
#     availability with `aws bedrock list-foundation-models`.

# ------------------------------------------------------- bedrock (native)
# Same Converse API, but pointed at a non-Anthropic catalog model. Kept as
# a separate provider because it takes its own model variable, so both can
# stay configured at once and you switch with RACIK_LLM_PROVIDER alone.
#
# RACIK_LLM_PROVIDER=bedrock_native
# BEDROCK_NATIVE_MODEL_ID=amazon.nova-lite-v1:0
# AWS_REGION=us-east-1
#
# amazon.nova-lite-v1:0 and amazon.nova-micro-v1:0 are reliable ON_DEMAND
# defaults when a Claude profile is unavailable on the account.

# ------------------------------------------- bedrock (SEA-LION, imported)
# SEA-LION itself imported into Bedrock via Custom Model Import. Setting
# BEDROCK_MODEL_ARN (and NOT BEDROCK_MODEL_ID) selects this path; the
# explicit provider name is `bedrock-sealion-import`.
#
# Getting the ARN requires the import job to already exist — upload
# SEA-LION's HF weights to S3 and run a Custom Model Import job in the AWS
# console or CLI. This file only points Racik at an import that is done.
#
# RACIK_LLM_PROVIDER=bedrock-sealion-import
# BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1:123456789012:imported-model/abc123
# AWS_REGION=us-east-1
#
# boto3 reads AWS credentials from its own standard chain here, so an
# AWS_PROFILE from `aws sso login` works as well as the explicit keys above.
#
# Custom Model Import exists only in us-east-1, us-east-2, us-west-2 and
# eu-central-1. No ap-southeast-1.
#
# Before relying on this for a live demo: run verify_deployment() (see
# racik/bedrock.py). AWS does not guarantee tool calling works for this
# model architecture, and the whole orchestrator depends on it.

# --------------------------------------------------------------- gateway
# Bedrock Access Gateway — an OpenAI-compatible HTTP shim in front of
# Bedrock, if your team is running one. No boto3, no code change.
# RACIK_LLM_PROVIDER=gateway
# SEALION_BASE_URL=http://localhost:8000/api/v1
# SEALION_MODEL=

# ------------------------------------------------------------------ data
# Only needed to regenerate data/nutrient_quality.json from the annotated
# TKPI copy (scripts/build_nutrient_quality.py). The engine never reads
# Supabase at runtime.
# SUPABASE_URL=
# SUPABASE_KEY=
